# Per-user Xcode state (keep shared schemes and Package.resolved)
xcuserdata/
*.xcuserstate
Packages/CrowCore/.swiftpm/
*.moved-aside

# Distribution artifacts (also when exported outside build/ or dist/)
*.ipa
*.dmg
/Crow-*.zip
/Crow-*.zip.sha256
/Crow-*.dmg.sha256

# Local environment and signing credentials
.env
.env.*
!.env.example
!.env.sample
*.p8
*.p12
*.pfx
*.mobileprovision
*.provisionprofile

# Python helper caches
__pycache__/
*.py[cod]

# Files deleted through Crow while working in this repository
.crow-trash/
.crow-trash-*/
